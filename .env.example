# Environment Configuration Example (No Secrets)

# Application URL
APP_URL="https://your-applet-url.run.app"
PORT=3000
NODE_ENV="development"

# Gemini AI API Key (Injected automatically in AI Studio runtime)
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Credentials (Cloud SQL PostgreSQL)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="your_database_password"
SQL_DB_NAME="lead_filtering_db"

# SalesForge CRM Integration Credentials
SALESFORGE_CRM_API_URL="https://api.salesforge.crm"
SALESFORGE_CRM_API_KEY="your_salesforge_api_key_here"

# Authentication Flags
MOCK_AUTH_ENABLED="true"
ALLOW_MOCK_AUTH_IN_PROD="false"
